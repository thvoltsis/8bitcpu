VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO thv_art
  CLASS BLOCK ;
  FOREIGN thv_art 0 0 ;
  ORIGIN 0 0 ;
  SIZE 31.000 BY 13.100 ;
  SYMMETRY X Y ;
  PIN VPWR
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met4 ;
        RECT 0.500 0.400 2.800 1.000 ;
    END
  END VPWR
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met4 ;
        RECT 3.800 0.400 6.100 1.000 ;
        RECT 19.900 0.400 22.200 1.000 ;
    END
  END VGND
  OBS
    LAYER met3 ;
      RECT 1.700 2.300 29.300 11.900 ;
  END
END thv_art
END LIBRARY
