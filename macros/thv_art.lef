VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO thv_art
  CLASS BLOCK ;
  FOREIGN thv_art 0 0 ;
  ORIGIN 0 0 ;
  SIZE 31.000 BY 15.700 ;
  SYMMETRY X Y ;
  PIN VPWR
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met3 ;
        RECT 0.500 0.400 30.500 2.000 ;
    END
  END VPWR
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met3 ;
        RECT 0.500 2.800 30.500 4.400 ;
    END
  END VGND
  OBS
    LAYER met3 ;
      RECT 1.700 4.900 29.300 14.500 ;
  END
END thv_art
END LIBRARY
