VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO thv_art
  CLASS BLOCK ;
  FOREIGN thv_art 0 0 ;
  ORIGIN 0 0 ;
  SIZE 74.500 BY 19.200 ;
  SYMMETRY X Y ;
  PIN VPWR
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met4 ;
        RECT 0.500 0.200 74.000 0.600 ;
    END
  END VPWR
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met4 ;
        RECT 0.500 1.000 74.000 1.400 ;
    END
  END VGND
  OBS
    LAYER met3 ;
      RECT 1.200 2.900 73.300 18.000 ;
  END
END thv_art
END LIBRARY
